<Project>
  <!-- 必须在 Sdk 之前：嵌入 meeko-platform 时不继承上层 Directory.Build.props -->
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <Sdk Name="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <Description>Demux control plane ↔ Gateway runtime MagicOnion contracts (Admin, LlmBackend, Internal, UserAuth). Dispatch RPC lives in OneApi.Common.</Description>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <!-- meeko-platform submodule: Contracts/Demux.Contracts -->
    <_MeekoContractsInPlatform>$(MSBuildThisFileDirectory)..\..\src\Meeko.Contracts\Meeko.Contracts.csproj</_MeekoContractsInPlatform>
    <!-- Monorepo: Demux 与 Meeko.Platform 并列 checkout -->
    <_MeekoContractsInMonorepo>$(MSBuildThisFileDirectory)..\..\..\Meeko.Platform\src\Meeko.Contracts\Meeko.Contracts.csproj</_MeekoContractsInMonorepo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(_MeekoContractsInPlatform)" Condition="Exists('$(_MeekoContractsInPlatform)')" />
    <ProjectReference Include="$(_MeekoContractsInMonorepo)" Condition="!Exists('$(_MeekoContractsInPlatform)') And Exists('$(_MeekoContractsInMonorepo)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Abstractions" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
